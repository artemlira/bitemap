rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublishedSpot() {
      return resource.data.visibility == "published";
    }

    function userSpot(spotId) {
      return get(/databases/$(database)/documents/user-spots/$(spotId));
    }

    function canContributeToSpot(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot"
          && (userSpot(targetId).data.visibility == "published"
            || isOwner(userSpot(targetId).data.ownerId)));
    }

    function canReadSpotImages(targetType, targetId, ownerId) {
      return isOwner(ownerId)
        || targetType == "catalog"
        || (targetType == "user-spot" && userSpot(targetId).data.visibility == "published");
    }

    function canContributeToReport(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot"
          && (userSpot(targetId).data.visibility == "published"
            || isOwner(userSpot(targetId).data.ownerId)));
    }

    function canPublishReport(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot" && userSpot(targetId).data.visibility == "published");
    }

    function isPublicReport(reportId) {
      return get(/databases/$(database)/documents/fishing-reports/$(reportId)).data.isPublic == true;
    }

    function isPublicImage(imageId) {
      let image = get(/databases/$(database)/documents/spot-images/$(imageId));
      return image.data.targetType == "catalog"
        || (image.data.targetType == "user-spot"
          && userSpot(image.data.targetId).data.visibility == "published");
    }

    match /users/{userId} {
      allow create, get, update, delete: if isOwner(userId);
      allow list: if false;

      match /favorites/{spotId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /public-profiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isOwner(userId);
      allow list, create, update, delete: if false;
    }

    match /content-reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          "targetType", "targetId", "parentId", "contextType", "contextId", "reporterId", "reason", "details", "status", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "targetType", "targetId", "parentId", "contextType", "contextId", "reporterId", "reason", "details", "status", "createdAt"
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType is string
        && request.resource.data.targetId is string
        && request.resource.data.contextType is string
        && request.resource.data.targetType in ["user-spot", "spot-image", "fishing-report", "comment", "article"]
        && request.resource.data.contextType in ["", "catalog", "user-spot"]
        && request.resource.data.contextId is string
        && request.resource.data.parentId is string
        && reportId == request.auth.uid + "__" + request.resource.data.targetType + "__"
          + request.resource.data.contextType + "__" + request.resource.data.contextId + "__"
          + request.resource.data.parentId + "__" + request.resource.data.targetId
        && request.resource.data.reason in ["spam", "abuse", "inaccurate", "privacy", "other"]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1200
        && request.resource.data.status == "open"
        && request.resource.data.createdAt is timestamp
        && ((request.resource.data.targetType == "user-spot"
              && userSpot(request.resource.data.targetId).data.visibility == "published")
          || (request.resource.data.targetType == "spot-image"
              && request.resource.data.parentId is string
              && request.resource.data.contextType in ["catalog", "user-spot"]
              && get(/databases/$(database)/documents/spot-images/$(request.resource.data.targetId)).data.targetId == request.resource.data.parentId
              && get(/databases/$(database)/documents/spot-images/$(request.resource.data.targetId)).data.targetType == request.resource.data.contextType
              && isPublicImage(request.resource.data.targetId))
          || (request.resource.data.targetType == "fishing-report"
              && request.resource.data.parentId is string
              && request.resource.data.contextType in ["catalog", "user-spot"]
              && get(/databases/$(database)/documents/fishing-reports/$(request.resource.data.targetId)).data.targetId == request.resource.data.parentId
              && get(/databases/$(database)/documents/fishing-reports/$(request.resource.data.targetId)).data.targetType == request.resource.data.contextType
              && get(/databases/$(database)/documents/fishing-reports/$(request.resource.data.targetId)).data.isPublic == true)
          || (request.resource.data.targetType == "comment"
              && request.resource.data.parentId is string
              && request.resource.data.contextId == get(/databases/$(database)/documents/fishing-reports/$(request.resource.data.parentId)).data.targetId
              && request.resource.data.contextType == get(/databases/$(database)/documents/fishing-reports/$(request.resource.data.parentId)).data.targetType
              && isPublicReport(request.resource.data.parentId)
              && exists(/databases/$(database)/documents/fishing-reports/$(request.resource.data.parentId)/comments/$(request.resource.data.targetId)))
          || (request.resource.data.targetType == "article"
              && get(/databases/$(database)/documents/articles/$(request.resource.data.targetId)).data.status == "published"));
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "reviewedAt", "reviewedBy"
        ])
        && request.resource.data.status in ["dismissed", "actioned"]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is timestamp;
      allow delete: if false;
    }

    match /angler-follows/{followId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(["followerId", "followedId", "createdAt"])
        && request.resource.data.keys().hasOnly(["followerId", "followedId", "createdAt"])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId is string
        && request.resource.data.followedId != request.auth.uid
        && request.resource.data.createdAt is timestamp
        && followId == request.auth.uid + "__" + request.resource.data.followedId;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    match /articles/{slug} {
      allow get, list: if isAdmin() || resource.data.status == "published";
      allow create: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ["draft", "published"];
      allow update: if isAdmin()
        && request.resource.data.slug == slug
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status in ["draft", "published"];
      allow delete: if isAdmin();
    }

    match /user-spots/{spotId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow get, list: if isPublishedSpot()
        || isOwner(resource.data.ownerId);
      allow update: if isSignedIn()
        && ((resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.get("moderationStatus", "") == resource.data.get("moderationStatus", "")
            && !(resource.data.get("moderationStatus", "") == "hidden"
              && request.resource.data.visibility == "published"))
          || (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility", "moderationStatus"])
            && request.resource.data.visibility == "private"
            && request.resource.data.moderationStatus == "hidden"));
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /spot-images/{imageId} {
      allow get, list: if canReadSpotImages(
        resource.data.targetType,
        resource.data.targetId,
        resource.data.ownerId,
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && canContributeToSpot(
          request.resource.data.targetType,
          request.resource.data.targetId,
        );
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetType == resource.data.targetType;
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      match /reactions/{userId} {
        allow get, list: if isPublicImage(imageId);
        allow create: if isSignedIn()
          && isPublicImage(imageId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasAll(["userId", "createdAt"])
          && request.resource.data.keys().hasOnly(["userId", "createdAt"])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isSignedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }

    match /fishing-reports/{reportId} {
      allow get, list: if resource.data.isPublic == true
        || isOwner(resource.data.authorId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && canContributeToReport(
          request.resource.data.targetType,
          request.resource.data.targetId,
        )
        && request.resource.data.isPublic == canPublishReport(
          request.resource.data.targetType,
          request.resource.data.targetId,
        );
      allow update: if (isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.isPublic == resource.data.isPublic
          && request.resource.data.get("moderationStatus", "") == resource.data.get("moderationStatus", ""))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isPublic", "moderationStatus"])
          && request.resource.data.isPublic == false
          && request.resource.data.moderationStatus == "hidden");
      allow delete: if isOwner(resource.data.authorId);

      match /comments/{commentId} {
        allow get, list: if isPublicReport(reportId);
        allow create: if isSignedIn()
          && isPublicReport(reportId)
          && request.resource.data.keys().hasAll(["authorId", "authorName", "body", "createdAt"])
          && request.resource.data.keys().hasOnly(["authorId", "authorName", "body", "createdAt"])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1200
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner(resource.data.authorId) || isAdmin();
      }

      match /reactions/{userId} {
        allow get, list: if isPublicReport(reportId);
        allow create: if isSignedIn()
          && isPublicReport(reportId)
          && userId == request.auth.uid
          && request.resource.data.keys().hasAll(["userId", "createdAt"])
          && request.resource.data.keys().hasOnly(["userId", "createdAt"])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isSignedIn()
          && userId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }
  }
}
