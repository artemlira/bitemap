rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublishedSpot() {
      return resource.data.visibility == "published";
    }

    function userSpot(spotId) {
      return get(/databases/$(database)/documents/user-spots/$(spotId));
    }

    function canContributeToSpot(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot"
          && (userSpot(targetId).data.visibility == "published"
            || isOwner(userSpot(targetId).data.ownerId)));
    }

    function canReadSpotImages(targetType, targetId, ownerId) {
      return isOwner(ownerId)
        || targetType == "catalog"
        || (targetType == "user-spot" && userSpot(targetId).data.visibility == "published");
    }

    function canContributeToReport(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot"
          && (userSpot(targetId).data.visibility == "published"
            || isOwner(userSpot(targetId).data.ownerId)));
    }

    function canPublishReport(targetType, targetId) {
      return targetType == "catalog"
        || (targetType == "user-spot" && userSpot(targetId).data.visibility == "published");
    }

    match /users/{userId} {
      allow create, get, update, delete: if isOwner(userId);
      allow list: if false;

      match /favorites/{spotId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /public-profiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /user-spots/{spotId} {
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow get, list: if isPublishedSpot()
        || isOwner(resource.data.ownerId);
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /spot-images/{imageId} {
      allow get, list: if canReadSpotImages(
        resource.data.targetType,
        resource.data.targetId,
        resource.data.ownerId,
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && canContributeToSpot(
          request.resource.data.targetType,
          request.resource.data.targetId,
        );
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetType == resource.data.targetType;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /fishing-reports/{reportId} {
      allow get, list: if resource.data.isPublic == true
        || isOwner(resource.data.authorId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && canContributeToReport(
          request.resource.data.targetType,
          request.resource.data.targetId,
        )
        && request.resource.data.isPublic == canPublishReport(
          request.resource.data.targetType,
          request.resource.data.targetId,
        );
    }
  }
}
