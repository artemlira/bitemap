NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Keep search indexing disabled during development. Set to true only when the public site is ready.
BITEMAP_SEARCH_INDEXING_ENABLED=false
# Set true only when using the local Firebase Auth and Firestore emulators.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: WordPress site used as the editorial CMS for articles (REST API, no auth needed for public posts).
WORDPRESS_URL=
# Optional: secret for POST /api/revalidate (send it in the x-revalidate-secret header from a WordPress webhook).
REVALIDATE_SECRET=
