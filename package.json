{
  "name": "bitemap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-bitemap",
    "test": "tsc --target ES2022 --module commonjs --moduleResolution node --skipLibCheck --outDir node_modules/.cache/bitemap-tests src/entities/weather-forecast/model/fishing-activity.ts && node --test tests/weather-forecast.test.mjs",
    "test:e2e": "node scripts/run-emulator-tests.mjs e2e",
    "test:rules": "node scripts/run-emulator-tests.mjs rules"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cloudinary": "^2.11.0",
    "firebase": "^12.19.0",
    "isomorphic-dompurify": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "ua-geo-set": "^1.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.32.1",
    "sass": "^1.105.0",
    "typescript": "^5"
  }
